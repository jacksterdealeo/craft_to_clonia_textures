# Allowlisting gitignore template for GO projects prevents us
# from adding various unwanted local files, such as generated
# files, developer configurations or IDE-specific files etc.
#
# Recommended: Go.AllowList.gitignore

# Ignore everything
*

# But not these files...
!/.gitignore

!*.go
!*.png
!go.sum
!go.mod

!README.md
!CONFIG.md
!LICENSE
!build.sh

!/ctc_lib/
!/ctc_lib/configure/
!/ctc_lib/data/
!/ctc_lib/mcmetahandler/
!/ctc_lib/stitches/

!/ctc_lib/data/textures/
!/ctc_lib/data/textures/16/
!/ctc_lib/data/textures/16/*

# !Makefile
